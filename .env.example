# Server Configuration
PORT=5000

# Database Configuration
# Replace with your actual MongoDB connection string 
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mediqueue?retryWrites=true&w=majority

# BetterAuth / Authentication Configuration
# On your local machine, this is usually http://localhost:5000
BETTER_AUTH_URL=http://localhost:5000

# Generate a secure random string for your secret key
BETTER_AUTH_SECRET=your_better_auth_secret_here
